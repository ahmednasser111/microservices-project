[Unit]
Description=Bring up the production docker compose stack (respects depends_on/health ordering)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
User=azureuser
WorkingDirectory=/home/azureuser/microservices-project
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.prod.yml stop
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
