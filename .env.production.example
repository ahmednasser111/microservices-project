# Copy this to `.env` next to docker-compose.prod.yml (on the VM, not committed) and fill in
# real values. docker compose loads `.env` automatically.

# ---- Postgres (shared instance, authdb + chatdb) ----
# Avoid special URL characters (# @ / : space) — this value is embedded directly into
# DATABASE_URL connection strings without escaping. Alphanumeric + hyphens/underscores only.
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=change_me_to_a_long_random_alphanumeric_value

# ---- Auth ----
# Must be identical for auth-service and chat-service — chat-service verifies tokens that
# auth-service issues. Generate one with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_value

# ---- CORS ----
# Comma-separated, no spaces. Include your Vercel frontend's production URL (and preview
# URLs if you need those to work too).
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# ---- Sentry (optional — leave blank to disable) ----
SENTRY_DSN_AUTH=
SENTRY_DSN_CHAT=

# ---- HTTPS ----
# The Azure-provided free DNS label for the VM's public IP, e.g.:
#   myapp.eastus.cloudapp.azure.com
# Caddy requests a Let's Encrypt certificate for this domain automatically, so it must
# already resolve to the VM's public IP before the stack starts.
AZURE_DNS_LABEL=myapp.eastus.cloudapp.azure.com
